{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cape-pins/dataset.schema.json",
  "title": "CAPE-Pins data manifest row (spec section 27)",
  "type": "object",
  "required": ["sample_id", "family_id", "source_id", "specimen_id", "macroblock_id", "split", "path",
               "source_url", "source_version", "license", "citation", "array_key", "axes", "dtype", "shape",
               "bbox_xyz", "spacing_xyz", "original_file_sha256", "voxel_sha256", "is_synthetic", "selection_rule"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "specimen_id": {"type": ["string", "null"]},
    "macroblock_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["synthetic", "development", "heldout"]},
    "path": {"type": "string", "minLength": 1, "description": "canonical ZYX C-order .npy crop"},
    "original_path": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]},
    "source_version": {"type": ["string", "null"]},
    "license": {"type": "string"},
    "citation": {"type": ["string", "null"]},
    "array_key": {"type": ["string", "null"]},
    "axes": {"const": "ZYX", "description": "axes of the materialized canonical crop"},
    "source_axes": {"type": ["string", "null"]},
    "dtype": {"enum": ["uint8", "uint16", "uint32", "uint64"]},
    "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 3, "maxItems": 3,
              "description": "canonical (Z, Y, X)"},
    "bbox_xyz": {"type": ["array", "null"], "description": "half-open [[x0,x1],[y0,y1],[z0,z1]] in source voxels",
                 "items": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}},
    "spacing_xyz": {"type": ["array", "null"], "items": {"type": "number"}},
    "original_file_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "voxel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "is_synthetic": {"type": "boolean"},
    "selection_rule": {"type": "string", "minLength": 1},
    "null_reasons": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": true
}
